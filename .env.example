# 巨量云图汽车版 API 鉴权配置 (脱敏模板)
# 从登录巨量云图后台（https://yuntu.oceanengine.com）后的浏览器抓包获取

# 1. 登录会话完整 Cookie
YUNTU_COOKIE="sessionid=your_session_id; advertiser_id=your_adv_id; passport_csrf_token=your_csrf_token"

# 2. 云图账户 aadvid (品牌或服务商账户 ID)
YUNTU_AADVID="1637827271287884"

# 3. 默认品牌 ID (广汽传祺为 7360)
YUNTU_DEFAULT_BRAND_ID="7360"

# 4. 行业 ID (汽车行业固定为 10)
YUNTU_INDUSTRY_ID="10"
